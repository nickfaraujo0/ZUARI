generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRECTOR
  PROJECT_MANAGER
  SITE_SUPERVISOR
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  HOSPITALITY
  INSTITUTIONAL
  OTHER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ── Tenant root ────────────────────────────────────────────────
model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users    User[]
  projects Project[]

  projectMembers  ProjectMember[]
  projectPhases   ProjectPhase[]
  tasks           Task[]
  taskComments    TaskComment[]
  progressUpdates ProgressUpdate[]
  progressPhotos  ProgressPhoto[]
  issues          Issue[]
  siteReports     SiteReport[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  email        String    @unique
  name         String
  passwordHash String
  role         Role
  title        String?
  phone        String?
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  managedProjects Project[]        @relation("ProjectManager")
  memberships     ProjectMember[]
  assignedTasks   Task[]           @relation("TaskAssignee")
  createdTasks    Task[]           @relation("TaskCreator")
  comments        TaskComment[]
  updates         ProgressUpdate[]
  photos          ProgressPhoto[]
  reportedIssues  Issue[]          @relation("IssueReporter")
  assignedIssues  Issue[]          @relation("IssueAssignee")
  siteReports     SiteReport[]
  notifications   Notification[]
  activity        ActivityLog[]
  passwordResets  PasswordReset[]

  @@index([companyId])
}

// ── Projects ───────────────────────────────────────────────────
model Project {
  id          String        @id @default(cuid())
  companyId   String
  code        String
  name        String
  client      String
  location    String
  type        ProjectType   @default(RESIDENTIAL)
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime
  expectedEnd DateTime
  budget      Decimal       @default(0) @db.Decimal(16, 2)
  description String?
  managerId   String?
  progress    Int           @default(0)
  createdAt   DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  members  ProjectMember[]
  phases   ProjectPhase[]
  tasks    Task[]
  updates  ProgressUpdate[]
  photos   ProgressPhoto[]
  issues   Issue[]
  reports  SiteReport[]
  activity ActivityLog[]

  @@unique([companyId, code])
  @@index([companyId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  companyId String
  projectId String
  userId    String
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([companyId])
}

model ProjectPhase {
  id        String   @id @default(cuid())
  companyId String
  projectId String
  name      String
  position  Int
  startDate DateTime
  endDate   DateTime
  progress  Int      @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([companyId])
}

// ── Work ───────────────────────────────────────────────────────
model Task {
  id          String     @id @default(cuid())
  companyId   String
  projectId   String
  phaseId     String?
  title       String
  description String?
  assigneeId  String?
  createdById String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(NOT_STARTED)
  progress    Int        @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase     ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  assignee  User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  comments TaskComment[]
  updates  ProgressUpdate[]
  photos   ProgressPhoto[]
  issues   Issue[]
  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assigneeId])
  @@index([companyId])
}

model TaskComment {
  id        String   @id @default(cuid())
  companyId String
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// A ProgressUpdate is a supervisor's submission: note + status change + photos.
model ProgressUpdate {
  id           String      @id @default(cuid())
  companyId    String
  clientId     String?
  projectId    String
  taskId       String?
  userId       String
  note         String?
  statusBefore TaskStatus?
  statusAfter  TaskStatus?
  progress     Int?
  createdAt    DateTime    @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos  ProgressPhoto[]
  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, clientId])
  @@index([projectId, createdAt])
  @@index([companyId])
}

// Photos are project evidence: always tied to a project and a person, usually a task.
model ProgressPhoto {
  id               String   @id @default(cuid())
  companyId        String
  projectId        String
  taskId           String?
  progressUpdateId String?
  issueId          String?
  siteReportId     String?
  userId           String
  storageKey       String   @unique
  mime             String
  size             Int
  caption          String?
  takenAt          DateTime @default(now())

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  progressUpdate ProgressUpdate? @relation(fields: [progressUpdateId], references: [id], onDelete: SetNull)
  issue          Issue?          @relation(fields: [issueId], references: [id], onDelete: SetNull)
  siteReport     SiteReport?     @relation(fields: [siteReportId], references: [id], onDelete: SetNull)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([projectId, takenAt])
  @@index([companyId])
}

model Issue {
  id          String      @id @default(cuid())
  companyId   String
  clientId    String?
  projectId   String
  taskId      String?
  area        String?
  title       String
  description String?
  severity    Severity    @default(MEDIUM)
  status      IssueStatus @default(OPEN)
  reporterId  String
  assigneeId  String?
  dueDate     DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reporter User            @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee User?           @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  photos   ProgressPhoto[]
  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, clientId])
  @@index([projectId, status])
  @@index([companyId])
}

model SiteReport {
  id                String   @id @default(cuid())
  companyId         String
  clientId          String?
  projectId         String
  userId            String
  date              DateTime @default(now())
  workCompleted     String?
  workPlanned       String?
  workforceCount    Int      @default(0)
  materialsReceived String?
  notes             String?
  createdAt         DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos  ProgressPhoto[]
  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, clientId])
  @@index([projectId, date])
  @@index([companyId])
}

// ── Communication & audit ──────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  type      String
  title     String
  body      String?
  href      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  companyId String
  projectId String?
  actorId   String?
  type      String
  message   String
  detail    String?
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([companyId, createdAt])
}

// Single-use, hashed, expiring password-reset tokens (self-service "forgot password").
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
