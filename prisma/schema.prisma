generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRECTOR
  PROJECT_MANAGER
  SITE_ENGINEER
  SITE_SUPERVISOR
  CONTRACTOR
  ACCOUNTANT
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  HOSPITALITY
  INSTITUTIONAL
  OTHER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ── Tenant root ────────────────────────────────────────────────
model Company {
  id            String   @id @default(cuid())
  name          String
  createdAt     DateTime @default(now())
  address       String?
  gstin         String?
  phone         String?
  email         String?
  phaseTemplate String[] @default(["Foundation", "Structure", "Masonry", "Electrical", "Plumbing", "Finishing"])

  users    User[]
  projects Project[]

  projectMembers      ProjectMember[]
  projectPhases       ProjectPhase[]
  tasks               Task[]
  taskComments        TaskComment[]
  progressUpdates     ProgressUpdate[]
  progressPhotos      ProgressPhoto[]
  issues              Issue[]
  siteReports         SiteReport[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  contractors         Contractor[]
  suppliers           Supplier[]
  workers             Worker[]
  attendance          Attendance[]
  materials           Material[]
  materialTxns        MaterialTxn[]
  materialRequests    MaterialRequest[]
  purchaseOrders      PurchaseOrder[]
  purchaseOrderLines  PurchaseOrderLine[]
  budgetLines         BudgetLine[]
  expenses            Expense[]
  documents           Document[]
  documentVersions    DocumentVersion[]
  escalateIssueHours  Int                  @default(4)
  escalateTaskDays    Int                  @default(3)
  tallyBankLedger     String               @default("Bank Account")
  inspectionTemplates InspectionTemplate[]
  inspections         Inspection[]
  inspectionItems     InspectionItem[]
  delayLogs           DelayLog[]
  raBills             RABill[]
  raBillLines         RABillLine[]
  clientShares        ClientShare[]
  safetyIncidents     SafetyIncident[]
  toolboxTalks        ToolboxTalk[]
  warranties          Warranty[]
  warehouses          Warehouse[]
  inventoryItems      InventoryItem[]
  inventoryTransfers  InventoryTransfer[]
  inventoryTxns       InventoryTxn[]
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  email        String    @unique
  name         String
  passwordHash String
  role         Role
  title        String?
  phone        String?
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  tokenVersion Int       @default(0)
  contractorId String?
  createdAt    DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  managedProjects    Project[]           @relation("ProjectManager")
  memberships        ProjectMember[]
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  comments           TaskComment[]
  updates            ProgressUpdate[]
  photos             ProgressPhoto[]
  reportedIssues     Issue[]             @relation("IssueReporter")
  assignedIssues     Issue[]             @relation("IssueAssignee")
  siteReports        SiteReport[]
  notifications      Notification[]
  activity           ActivityLog[]
  passwordResets     PasswordReset[]
  contractor         Contractor?         @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  materialTxns       MaterialTxn[]
  materialRequests   MaterialRequest[]
  createdPOs         PurchaseOrder[]
  createdExpenses    Expense[]
  docVersions        DocumentVersion[]
  digest             String              @default("NONE")
  locale             String              @default("en")
  waOptIn            Boolean             @default(false)
  inspections        Inspection[]
  safetyReports      SafetyIncident[]
  toolboxTalks       ToolboxTalk[]
  pushSubs           PushSubscription[]
  phoneKey           String?
  inventoryTransfers InventoryTransfer[]
  inventoryTxns      InventoryTxn[]

  @@index([companyId])
  @@index([phoneKey])
}

// ── Projects ───────────────────────────────────────────────────
model Project {
  id          String        @id @default(cuid())
  companyId   String
  code        String
  name        String
  client      String
  location    String
  type        ProjectType   @default(RESIDENTIAL)
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime
  expectedEnd DateTime
  budget      Decimal       @default(0) @db.Decimal(16, 2)
  description String?
  managerId   String?
  progress    Int           @default(0)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  members          ProjectMember[]
  phases           ProjectPhase[]
  tasks            Task[]
  updates          ProgressUpdate[]
  photos           ProgressPhoto[]
  issues           Issue[]
  reports          SiteReport[]
  activity         ActivityLog[]
  attendance       Attendance[]
  materialTxns     MaterialTxn[]
  materialRequests MaterialRequest[]
  purchaseOrders   PurchaseOrder[]
  budgetLines      BudgetLine[]
  expenses         Expense[]
  documents        Document[]
  inspections      Inspection[]
  delayLogs        DelayLog[]
  raBills          RABill[]
  clientShares     ClientShare[]
  safetyIncidents  SafetyIncident[]
  toolboxTalks     ToolboxTalk[]
  warranties       Warranty[]
  inventoryTxns    InventoryTxn[]
  transfersOut     InventoryTransfer[] @relation("TrFromProject")
  transfersIn      InventoryTransfer[] @relation("TrToProject")

  @@unique([companyId, code])
  @@index([companyId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  companyId String
  projectId String
  userId    String
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([companyId])
}

model ProjectPhase {
  id        String   @id @default(cuid())
  companyId String
  projectId String
  name      String
  position  Int
  startDate DateTime
  endDate   DateTime
  progress  Int      @default(0)

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  delayLogs DelayLog[]

  @@index([projectId])
  @@index([companyId])
}

// ── Work ───────────────────────────────────────────────────────
model Task {
  id          String     @id @default(cuid())
  companyId   String
  projectId   String
  phaseId     String?
  title       String
  description String?
  assigneeId  String?
  createdById String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(NOT_STARTED)
  progress    Int        @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase     ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  assignee  User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  comments         TaskComment[]
  updates          ProgressUpdate[]
  photos           ProgressPhoto[]
  issues           Issue[]
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  weatherSensitive Boolean          @default(false)
  quantityTotal    Float?
  quantityDone     Float            @default(0)
  quantityUnit     String?
  inspections      Inspection[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([companyId])
}

model TaskComment {
  id        String   @id @default(cuid())
  companyId String
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// A ProgressUpdate is a supervisor's submission: note + status change + photos.
model ProgressUpdate {
  id           String      @id @default(cuid())
  companyId    String
  block        String?
  floor        String?
  locationArea String?
  clientId     String?
  projectId    String
  taskId       String?
  userId       String
  note         String?
  statusBefore TaskStatus?
  statusAfter  TaskStatus?
  progress     Int?
  createdAt    DateTime    @default(now())

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos   ProgressPhoto[]
  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quantity Float?

  @@unique([companyId, clientId])
  @@index([projectId, createdAt])
  @@index([companyId])
}

// Photos are project evidence: always tied to a project and a person, usually a task.
model ProgressPhoto {
  id               String   @id @default(cuid())
  companyId        String
  block            String?
  floor            String?
  locationArea     String?
  projectId        String
  taskId           String?
  progressUpdateId String?
  issueId          String?
  siteReportId     String?
  userId           String
  storageKey       String   @unique
  mime             String
  size             Int
  caption          String?
  takenAt          DateTime @default(now())

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  progressUpdate ProgressUpdate? @relation(fields: [progressUpdateId], references: [id], onDelete: SetNull)
  issue          Issue?          @relation(fields: [issueId], references: [id], onDelete: SetNull)
  siteReport     SiteReport?     @relation(fields: [siteReportId], references: [id], onDelete: SetNull)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientVisible  Boolean         @default(false)
  inspectionId   String?
  inspection     Inspection?     @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@index([projectId, takenAt])
  @@index([companyId])
}

model Issue {
  id          String      @id @default(cuid())
  companyId   String
  clientId    String?
  projectId   String
  taskId      String?
  area        String?
  block       String?
  floor       String?
  title       String
  description String?
  severity    Severity    @default(MEDIUM)
  status      IssueStatus @default(OPEN)
  reporterId  String
  assigneeId  String?
  dueDate     DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())

  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task             Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reporter         User            @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee         User?           @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  photos           ProgressPhoto[]
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inspectionItemId String?
  inspectionItem   InspectionItem? @relation(fields: [inspectionItemId], references: [id], onDelete: SetNull)
  documentId       String?
  document         Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  pinX             Float?
  pinY             Float?
  docVersion       Int?

  @@unique([companyId, clientId])
  @@index([projectId, status])
  @@index([companyId])
}

model SiteReport {
  id                String   @id @default(cuid())
  companyId         String
  clientId          String?
  projectId         String
  userId            String
  date              DateTime @default(now())
  workCompleted     String?
  workPlanned       String?
  workforceCount    Int      @default(0)
  materialsReceived String?
  notes             String?
  createdAt         DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos  ProgressPhoto[]
  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, clientId])
  @@index([projectId, date])
  @@index([companyId])
}

// ── Communication & audit ──────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  type      String
  title     String
  body      String?
  href      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  companyId String
  projectId String?
  actorId   String?
  type      String
  message   String
  detail    String?
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([companyId, createdAt])
}

// Single-use, hashed, expiring password-reset tokens (self-service "forgot password").
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ── Phase 2: people, materials, procurement, finance, documents ─────────────
enum AttendanceStatus {
  PRESENT
  HALF
  ABSENT
}

enum TxnType {
  RECEIVED
  CONSUMED
  ADJUSTMENT
}

enum RequestStatus {
  REQUESTED
  APPROVED
  ORDERED
  FULFILLED
  REJECTED
}

enum PoStatus {
  DRAFT
  APPROVED
  ORDERED
  DELIVERED
  CANCELLED
}

enum ExpenseCategory {
  LABOUR
  MATERIALS
  SUBCONTRACT
  EQUIPMENT
  OVERHEADS
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
}

enum DocCategory {
  DRAWING
  CONTRACT
  BOQ
  QUOTATION
  PURCHASE_ORDER
  INVOICE
  REPORT
  CERTIFICATE
  OTHER
}

enum DocAudience {
  MANAGERS
  PROJECT
  EXTERNAL
}

model Contractor {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  trade       String
  contactName String?
  phone       String?
  email       String?
  gstin       String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users    User[]
  workers  Worker[]
  expenses Expense[]
  raBills  RABill[]

  @@index([companyId])
}

model Supplier {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  category    String?
  contactName String?
  phone       String?
  email       String?
  gstin       String?
  address     String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders   PurchaseOrder[]
  expenses Expense[]
  txns     MaterialTxn[]

  @@index([companyId])
}

model Worker {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  trade        String
  phone        String?
  dailyRate    Decimal  @default(0) @db.Decimal(10, 2)
  contractorId String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractor        Contractor?       @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  attendance        Attendance[]
  toolboxAttendance ToolboxAttendee[]

  @@index([companyId])
}

model Attendance {
  id            String           @id @default(cuid())
  companyId     String
  projectId     String
  workerId      String
  date          DateTime
  status        AttendanceStatus @default(PRESENT)
  overtimeHours Float            @default(0)
  markedById    String
  createdAt     DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@index([projectId, date])
}

model Material {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  unit         String
  category     String?
  reorderLevel Float    @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  txns     MaterialTxn[]
  requests MaterialRequest[]
  poLines  PurchaseOrderLine[]

  @@index([companyId])
}

model MaterialTxn {
  id         String   @id @default(cuid())
  companyId  String
  projectId  String
  materialId String
  type       TxnType
  quantity   Float
  note       String?
  supplierId String?
  poId       String?
  userId     String
  clientId   String?
  createdAt  DateTime @default(now())

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  po       PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, clientId])
  @@index([projectId, materialId])
}

model MaterialRequest {
  id            String        @id @default(cuid())
  companyId     String
  projectId     String
  materialId    String
  quantity      Float
  neededBy      DateTime?
  status        RequestStatus @default(REQUESTED)
  note          String?
  requestedById String
  decidedById   String?
  poId          String?
  clientId      String?
  createdAt     DateTime      @default(now())

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material    Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  requestedBy User           @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  po          PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)

  @@unique([companyId, clientId])
  @@index([projectId, status])
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  companyId    String
  projectId    String
  supplierId   String
  number       String
  status       PoStatus  @default(DRAFT)
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  notes        String?
  createdById  String
  approvedById String?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  createdBy User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lines     PurchaseOrderLine[]
  expenses  Expense[]
  txns      MaterialTxn[]
  requests  MaterialRequest[]

  @@unique([companyId, number])
  @@index([projectId, status])
}

model PurchaseOrderLine {
  id          String  @id @default(cuid())
  companyId   String
  poId        String
  materialId  String?
  description String
  quantity    Float
  unit        String
  rate        Decimal @default(0) @db.Decimal(12, 2)

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  po       PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  material Material?     @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([poId])
}

model BudgetLine {
  id        String          @id @default(cuid())
  companyId String
  projectId String
  category  ExpenseCategory
  name      String
  amount    Decimal         @db.Decimal(16, 2)
  createdAt DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Expense {
  id            String          @id @default(cuid())
  companyId     String
  projectId     String
  category      ExpenseCategory
  description   String
  amount        Decimal         @db.Decimal(16, 2)
  date          DateTime
  invoiceNo     String?
  supplierId    String?
  contractorId  String?
  poId          String?
  status        ExpenseStatus   @default(PENDING)
  approvedById  String?
  paidAt        DateTime?
  paymentMethod String?
  paymentRef    String?
  createdById   String
  createdAt     DateTime        @default(now())

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  contractor Contractor?    @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  po         PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  createdBy  User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  raBill     RABill?

  @@index([projectId, status])
  @@index([companyId, date])
}

model Document {
  id             String      @id @default(cuid())
  companyId      String
  projectId      String
  title          String
  category       DocCategory @default(OTHER)
  audience       DocAudience @default(PROJECT)
  discipline     String?
  currentVersion Int         @default(1)
  createdAt      DateTime    @default(now())

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions     DocumentVersion[]
  pinnedIssues Issue[]

  @@index([projectId, category])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  companyId    String
  documentId   String
  version      Int
  storageKey   String   @unique
  filename     String
  mime         String
  size         Int
  note         String?
  uploadedById String
  createdAt    DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

// ── Phase 3: inspections, safety, delays, bills, sharing, push, warranties ───
enum InspectionStatus {
  OPEN
  PASSED
  FAILED
}

enum ItemResult {
  PENDING
  PASS
  FAIL
  NA
}

enum DelayCause {
  WEATHER
  MATERIAL
  APPROVAL
  LABOUR
  DESIGN
  EQUIPMENT
  OTHER
}

enum BillStatus {
  DRAFT
  SUBMITTED
  CERTIFIED
  INVOICED
}

enum SafetyKind {
  INCIDENT
  NEAR_MISS
  HAZARD
}

model InspectionTemplate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  category  String?
  items     String[]
  createdAt DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inspections Inspection[]

  @@index([companyId])
}

model Inspection {
  id           String           @id @default(cuid())
  companyId    String
  projectId    String
  taskId       String?
  templateId   String?
  parentId     String?
  title        String
  block        String?
  floor        String?
  locationArea String?
  status       InspectionStatus @default(OPEN)
  inspectorId  String
  note         String?
  clientId     String?
  createdAt    DateTime         @default(now())
  completedAt  DateTime?

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  template  InspectionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  inspector User                @relation(fields: [inspectorId], references: [id], onDelete: Cascade)
  parent    Inspection?         @relation("Reinspect", fields: [parentId], references: [id], onDelete: SetNull)
  children  Inspection[]        @relation("Reinspect")
  items     InspectionItem[]
  photos    ProgressPhoto[]

  @@unique([companyId, clientId])
  @@index([projectId, status])
}

model InspectionItem {
  id           String     @id @default(cuid())
  companyId    String
  inspectionId String
  position     Int
  text         String
  result       ItemResult @default(PENDING)
  note         String?

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  issues     Issue[]

  @@index([inspectionId])
}

model DelayLog {
  id          String     @id @default(cuid())
  companyId   String
  projectId   String
  phaseId     String?
  date        DateTime
  cause       DelayCause
  days        Float      @default(1)
  note        String?
  source      String     @default("MANUAL")
  createdById String
  createdAt   DateTime   @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@unique([projectId, date, cause])
  @@index([projectId, date])
}

model RABill {
  id            String     @id @default(cuid())
  companyId     String
  projectId     String
  contractorId  String
  number        String
  periodFrom    DateTime
  periodTo      DateTime
  status        BillStatus @default(DRAFT)
  retentionPct  Float      @default(5)
  tdsPct        Float      @default(1)
  gstPct        Float      @default(18)
  notes         String?
  createdById   String
  certifiedById String?
  expenseId     String?    @unique
  createdAt     DateTime   @default(now())

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor Contractor   @relation(fields: [contractorId], references: [id], onDelete: NoAction)
  expense    Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  lines      RABillLine[]

  @@unique([companyId, number])
  @@index([projectId, status])
}

model RABillLine {
  id           String  @id @default(cuid())
  companyId    String
  billId       String
  description  String
  unit         String
  quantity     Float
  rate         Decimal @db.Decimal(12, 2)
  prevQuantity Float   @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bill    RABill  @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

model ClientShare {
  id           String    @id @default(cuid())
  companyId    String
  projectId    String
  tokenHash    String    @unique
  label        String?
  showActivity Boolean   @default(true)
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SafetyIncident {
  id           String     @id @default(cuid())
  companyId    String
  projectId    String
  kind         SafetyKind
  severity     Severity   @default(MEDIUM)
  description  String
  block        String?
  floor        String?
  area         String?
  injuredCount Int        @default(0)
  actionsTaken String?
  closed       Boolean    @default(false)
  reportedById String
  createdAt    DateTime   @default(now())
  closedAt     DateTime?

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedBy User    @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ToolboxTalk {
  id            String   @id @default(cuid())
  companyId     String
  projectId     String
  topic         String
  notes         String?
  date          DateTime
  conductedById String
  createdAt     DateTime @default(now())

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conductedBy User              @relation(fields: [conductedById], references: [id], onDelete: Cascade)
  attendees   ToolboxAttendee[]

  @@index([projectId, date])
}

model ToolboxAttendee {
  talkId   String
  workerId String

  talk   ToolboxTalk @relation(fields: [talkId], references: [id], onDelete: Cascade)
  worker Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([talkId, workerId])
}

model Warranty {
  id         String    @id @default(cuid())
  companyId  String
  projectId  String
  item       String
  provider   String?
  startDate  DateTime
  endDate    DateTime
  notes      String?
  notifiedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, endDate])
}

// De-duplicates inbound WhatsApp deliveries (Meta retries).
model WaInbound {
  id        String   @id
  userId    String?
  createdAt DateTime @default(now())
}

// ── Inventory: reusable assets (tools, scaffolding, equipment) across warehouses and sites ──
enum InvKind {
  RECEIPT
  TRANSFER
  WRITE_OFF
  ADJUSTMENT
}

model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String?
  contact   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  txns         InventoryTxn[]
  transfersOut InventoryTransfer[] @relation("TrFromWarehouse")
  transfersIn  InventoryTransfer[] @relation("TrToWarehouse")

  @@index([companyId])
}

model InventoryItem {
  id        String   @id @default(cuid())
  companyId String
  name      String
  category  String
  unit      String   @default("nos")
  unitCost  Decimal? @db.Decimal(12, 2)
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  txns    InventoryTxn[]

  @@index([companyId])
}

// One dispatch (challan) from one location to another; its lines are the InventoryTxn rows.
model InventoryTransfer {
  id              String   @id @default(cuid())
  companyId       String
  number          String
  date            DateTime
  fromWarehouseId String?
  fromProjectId   String?
  toWarehouseId   String?
  toProjectId     String?
  vehicle         String?
  driver          String?
  note            String?
  createdById     String
  createdAt       DateTime @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse?     @relation("TrFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: NoAction)
  toWarehouse   Warehouse?     @relation("TrToWarehouse", fields: [toWarehouseId], references: [id], onDelete: NoAction)
  fromProject   Project?       @relation("TrFromProject", fields: [fromProjectId], references: [id], onDelete: NoAction)
  toProject     Project?       @relation("TrToProject", fields: [toProjectId], references: [id], onDelete: NoAction)
  createdBy     User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  txns          InventoryTxn[]

  @@unique([companyId, number])
  @@index([companyId, date])
}

// The ledger. Quantity is signed; the stock of an item at a location is the sum of its rows.
model InventoryTxn {
  id          String   @id @default(cuid())
  companyId   String
  itemId      String
  warehouseId String?
  projectId   String?
  quantity    Float
  kind        InvKind
  transferId  String?
  date        DateTime
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item      InventoryItem      @relation(fields: [itemId], references: [id], onDelete: NoAction)
  warehouse Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: NoAction)
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: NoAction)
  transfer  InventoryTransfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)
  createdBy User               @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([companyId, itemId])
  @@index([warehouseId])
  @@index([projectId])
  @@index([transferId])
}
