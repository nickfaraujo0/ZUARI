DATABASE_URL="postgresql://zuari:zuari@localhost:5434/zuari?schema=public"
AUTH_SECRET="generate with: openssl rand -hex 32"
UPLOAD_DIR="./uploads"

# Public URL used in emailed links
APP_URL="http://localhost:3100"
# Email delivery (Resend). Leave unset in dev: emails are printed to the server log.
# RESEND_API_KEY=""
# MAIL_FROM="ZUARI <no-reply@yourdomain.com>"
# Set to 1 only to run a production build over plain http on a LAN/localhost (Safari drops Secure cookies).
# AUTH_INSECURE_COOKIES=1

# Web push: generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@yourdomain.com"
# Scheduled jobs call /api/cron/<escalate|digest-daily|digest-weekly|weekly-summary> with: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
# WhatsApp Business Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# AI answers (Ask ZUARI)
ANTHROPIC_API_KEY=""
